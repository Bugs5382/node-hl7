{
  "name": "node-hl7",
  "private": true,
  "description": "HL7 monorepo — node-hl7-client and node-hl7-server",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "check:dist": "node scripts/check-dist.mjs",
    "clean": "find packages -name 'node_modules' -maxdepth 2 -type d -exec rm -rf {} + 2>/dev/null; find packages -name 'lib' -maxdepth 2 -type d -exec rm -rf {} + 2>/dev/null; find packages -name 'dist' -maxdepth 2 -type d -exec rm -rf {} + 2>/dev/null; find packages -name 'coverage' -maxdepth 2 -type d -exec rm -rf {} + 2>/dev/null; true",
    "lint": "eslint && npm run lint:npm --workspaces --if-present",
    "lint:fix": "eslint --fix && npm run lint:npm --workspaces --if-present",
    "lint:package": "npx sort-package-json",
    "prepare": "husky",
    "test": "vitest run",
    "test:coverage": "vitest --coverage",
    "test:verbose": "vitest run --reporter verbose",
    "test:watch": "vitest watch",
    "typedoc": "npm run typedoc --workspaces --if-present",
    "update": "npm run update --workspaces --if-present",
    "update:local": "npx npm-check-updates -u --enginesNode && npm run update:post-update:local",
    "update:post-update:local": "rm -f package-lock.json && rm -rf node_modules && npm install && npm run test"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@shipgirl/typedoc-plugin-versions": "^0.3.3",
    "@the-rabbit-hole/eslint-config": "^0.7.0",
    "@types/node": "^26.6.6",
    "@types/tcp-port-used": "^1.0.4",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "npm-check-updates": "^23.1.1",
    "npm-package-json-lint": "^11.0.0",
    "npm-package-json-lint-config-default": "^10.0.0",
    "portfinder": "^1.0.38",
    "selfsigned": "^5.5.0",
    "sort-package-json": "^4.1.0",
    "tcp-port-used": "^1.0.3",
    "tsdown": "^0.23.4",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
