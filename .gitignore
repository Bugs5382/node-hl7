# Dependencies and the lockfile (CI generates it with `npm install --package-lock-only`).
node_modules/
package-lock.json

# Build output, coverage and caches, anywhere in the tree.
lib/
dist/
coverage/
.nyc_output/
temp/
docs/
*.tsbuildinfo
*.log
*.tgz

# Local design notes (non-tracked).
plan/

# Editors and OS files. .idea/.gitignore stays tracked.
.DS_Store
.idea/*
!.idea/.gitignore
.vscode/

# Local environment: copy .env.example to .env.
.env

# Track the shared governance (hooks and settings); other .claude files stay local.
/.claude/*
!/.claude/hooks/
!/.claude/settings.json
!/.claude/linux-only
